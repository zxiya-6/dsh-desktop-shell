'未知'}</code>`\n\n        const term = new Terminal({\n          fontFamily: 'Consolas, \"Courier New\", monospace',\n          fontSize: 13,\n          cursorBlink: true,\n          convertEol: true,\n          theme: {\n            background: '#0d0d0d',\n            foreground: '#d8dee9',\n            cursor: '#4d7cfe',\n            selectionBackground: 'rgba(77,124,254,0.3)'\n          }\n        })\n\n        const fitAddon = new FitAddon.FitAddon()\n        term.loadAddon(fitAddon)\n        try {\n          term.loadAddon(new WebLinksAddon.WebLinksAddon())\n        } catch (e) {\n          /* web-links is optional */\n        }\n\n        term.open(document.getElementById('terminal'))\n\n        const sessionId = 'term-' + Date.now()\n\n        const ro = new ResizeObserver(() => {\n          try {\n            fitAddon.fit()\n            api.terminal.resize(sessionId, term.cols, term.rows)\n          } catch (e) {\n            /* ignore transient resize failures */\n          }\n        })\n        ro.observe(document.getElementById('terminal'))\n\n        term.onData((data) => api.terminal.write(sessionId, data))\n\n        api.terminal.onData(sessionId, (data) => term.write(data))\n        api.terminal.onExit(sessionId, (info2) => {\n          const code = info2 && info2.code !== undefined ? info2.code : '?'\n          term.writeln(`\\r\\n[进程已退出，代码 ${code}]`)\n        })\n\n        try {\n          fitAddon.fit()\n          const created = await api.terminal.create(sessionId, term.cols, term.rows)\n          overlay.classList.add('hidden')\n          term.focus()\n\n          if (created && created.shell) {\n            badge.textContent = created.shell.label || badge.textContent\n          }\n        } catch (err) {\n          overlayText.innerHTML =\n            '<span class=\"err\">终端启动失败</span><br>' + (err && err.message ? err.message : String(err))\n        }\n\n        window.addEventListener('beforeunload', () => {\n          try {\n            api.terminal.dispose(sessionId)\n          } catch (e) {\n            /* ignore */\n          }\n        })\n      })()\n    "},"2hvrmtXzYhuYH0QVTSasVk":{"page-node-id":"2hvrmtXzYhuYH0QVTSasVk","type":"text","parentId":"XHYmPQjrwJyKePjKSwtslG","children":null,"content":"\n  "},"3PdTyI665VfWVifbtVj6uh":{"page-node-id":"3PdTyI665VfWVifbtVj6uh","type":"text","parentId":"SjN2JhooZuM9N0l3uyvB2Z","children":null,"content":"\n"},"ndL2bSh6oi5bIXkCdDxxq9":{"page-node-id":"ndL2bSh6oi5bIXkCdDxxq9","type":"text","parentId":"root","children":null,"content":"\n"}}