e;\n      }\n      * { box-sizing: border-box; }\n      html, body { margin: 0; height: 100%; overflow: hidden; }\n      body {\n        display: flex;\n        flex-direction: column;\n        background: var(--bg);\n        color: var(--text);\n        font-family: \"Segoe UI\", \"Microsoft YaHei\", system-ui, sans-serif;\n        font-size: 13px;\n      }\n\n      .bar {\n        display: flex;\n        align-items: center;\n        gap: 14px;\n        padding: 8px 14px;\n        background: var(--bar);\n        border-bottom: 1px solid var(--border);\n        flex: 0 0 auto;\n      }\n      .badge {\n        padding: 3px 9px;\n        border-radius: 5px;\n        background: rgba(77, 124, 254, 0.16);\n        color: #9db8ff;\n        font-size: 12px;\n        font-weight: 600;\n      }\n      .meta { color: var(--muted); font-size: 12px; }\n      .meta code {\n        font-family: Consolas, \"Courier New\", monospace;\n        color: #b9c3d1;\n        background: rgba(255, 255, 255, 0.05);\n        padding: 1px 5px;\n        border-radius: 4px;\n      }\n      .spacer { flex: 1; }\n      .tips { color: #5f6875; font-size: 11.5px; }\n\n      #terminal { flex: 1 1 auto; padding: 6px 0 0 8px; min-height: 0; }\n\n      .overlay {\n        position: absolute;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        flex-direction: column;\n        gap: 12px;\n        background: var(--bg);\n        color: var(--muted);\n        padding: 40px;\n        text-align: center;\n        line-height: 1.7;\n      }\n      .overlay.hidden { display: none; }\n      .overlay .err { color: #ff6b6b; font-weight: 600; }\n      .overlay code {\n        font-family: Consolas, \"Courier New\", monospace;\n        background: rgba(255, 255, 255, 0.06);\n        padding: 2px 6px;\n        border-radius: 4px;\n        color: #cbd5e1;\n      }\n    "},"8xHDEVaKgFStujWN0WlFtt":{"page-node-id":"8xHDEVaKgFStujWN0WlFtt","type":"text",