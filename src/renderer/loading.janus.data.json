padding: 40px 36px;\n        text-align: center;\n      }\n      .logo {\n        width: 64px;\n        height: 64px;\n        margin: 0 auto 20px;\n        border-radius: 16px;\n        background: linear-gradient(135deg, var(--accent), #6f4dfe);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 30px;\n        font-weight: 700;\n        color: #fff;\n      }\n      h1 { margin: 0 0 8px; font-size: 22px; font-weight: 600; }\n      .sub { margin: 0 0 28px; color: var(--muted); font-size: 13px; }\n\n      .spinner {\n        width: 34px;\n        height: 34px;\n        margin: 0 auto 18px;\n        border: 3px solid rgba(255, 255, 255, 0.12);\n        border-top-color: var(--accent);\n        border-radius: 50%;\n        animation: spin 0.9s linear infinite;\n      }\n      @keyframes spin { to { transform: rotate(360deg); } }\n\n      #message { font-size: 14px; color: var(--muted); min-height: 22px; }\n\n      /* Update progress — only meaningful when we are installing a kernel. */\n      .progress-wrap { display: none; margin-top: 18px; }\n      .progress-wrap.visible { display: block; }\n      .progress-track {\n        height: 6px;\n        background: rgba(255, 255, 255, 0.1);\n        border-radius: 99px;\n        overflow: hidden;\n      }\n      .progress-bar {\n        height: 100%;\n        width: 0;\n        background: linear-gradient(90deg, var(--accent), #6f4dfe);\n        border-radius: 99px;\n        transition: width 0.35s ease;\n      }\n      #progressLabel { margin-top: 10px; font-size: 12px; color: var(--muted); }\n      #progressOutput {\n        margin-top: 8px;\n        max-height: 120px;\n        overflow: auto;\n        text-align: left;\n        font-family: Consolas, \"Courier New\", monospace;\n        font-size: 11px;\n        line-height: 1.6;\n        color: #8b95a3;\n        white-space: pre-wrap;\n        word-break: break-all;\n        user-select: text;\n      }\n\n      .error-box {\n        display: none;\n        margin-top: 22px;\n        padding: 16px;\n        background: var(--panel);\n        border: 1px solid rgba(255, 107, 107, 0.35);\n        border-radius: 10px;\n        text-align: left;\n      }\n      .error-box.visible { display: block; }\n      .error-title {\n        color: var(--error);\n        font-weight: 600;\n        font-size: 13px;\n        margin-bottom: 8px;\n      }\n      .error-detail {\n        font-family: Consolas, \"Courier New\", monospace;\n        font-size: 12px;\n        line-height: 1.6;\n        color: #d5d5d5;\n        white-space: pre-wrap;\n        word-break: break-word;\n        max-height: 190px;\n        overflow: auto;\n        user-select: text;\n      }\n      .actions { margin-top: 20px; display: flex; gap: 10px; justify-content: center; }\n      button {\n        padding: 8px 18px;\n        font-size: 13px;\n        border-radius: 8px;\n        border: 1px solid rgba(255, 255, 255, 0.14);\n        background: transparent;\n        color: var(--text);\n        cursor: pointer;\n        font-family: inherit;\n      }\n      button:hover { background: rgba(255, 255, 255, 0.07); }\n      button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n      button.primary:hover { background: #3d6bf5; }\n      .hint { margin-top: 26px; font-size: 12px; color: #6b7480; line-height: 1.7; }\n    "},"YjgQnsSkS4JH5tN811Zaf3":{"page-node-id":"YjgQnsSkS4JH5tN811Zaf3","type":"text","parentId":"4VApxCSEz8YGSeYt5iMgvh","children":null,"content":"\n  "},"kRcXfa7evO9wFs3UboEdJZ":{"page-node-id":"kRcXfa7evO9wFs3UboEdJZ","type":"text","parentId":"YxLDaOY6Us7cW9xIXyl1BD","children":null,"content":"\n  "},"k3CNzCvd4wbyszIZXKso52":{"page-node-id":"k3CNzCvd4wbyszIZXKso52","type":"element","parentId":"YxLDaOY6Us7cW9xIXyl1BD","tag":"body","children":["LtzojymHYBoQGVa2N6Hss1","2fA0IWZEbqyMsyCa6Y9Ykv","OIhaF5mAWa74gjATafNTAo","YRDFsu66dU0x8BZaCeU9kY","UI0MhL8Xxw19C39dK8A6qg"]},"Ltzojym