5xks7YoV5OMy","type":"text","parentId":"JKMIpPr5rCBI4ZfbIpDm9h","children":null,"content":"\n      "},"voODiFY7cMo1c1KisxbuoL":{"page-node-id":"voODiFY7cMo1c1KisxbuoL","type":"text","parentId":"2fA0IWZEbqyMsyCa6Y9Ykv","children":null,"content":"\n\n      "},"CvuLCWsGwu8N59Kcz0UsRA":{"page-node-id":"CvuLCWsGwu8N59Kcz0UsRA","type":"element","parentId":"2fA0IWZEbqyMsyCa6Y9Ykv","tag":"div","attributes":{"class":"hint"},"children":["LtkkdFlcFr5ueekJfXGSBK"]},"LtkkdFlcFr5ueekJfXGSBK":{"page-node-id":"LtkkdFlcFr5ueekJfXGSBK","type":"text","parentId":"CvuLCWsGwu8N59Kcz0UsRA","children":null,"content":"\n        首次启动需要初始化 dsh profile 并安装依赖，可能需要 1-2 分钟。\n      "},"bJEG9FSAFEv5qfBX3GepOX":{"page-node-id":"bJEG9FSAFEv5qfBX3GepOX","type":"text","parentId":"2fA0IWZEbqyMsyCa6Y9Ykv","children":null,"content":"\n    "},"OIhaF5mAWa74gjATafNTAo":{"page-node-id":"OIhaF5mAWa74gjATafNTAo","type":"text","parentId":"k3CNzCvd4wbyszIZXKso52","children":null,"content":"\n\n    "},"YRDFsu66dU0x8BZaCeU9kY":{"page-node-id":"YRDFsu66dU0x8BZaCeU9kY","type":"element","parentId":"k3CNzCvd4wbyszIZXKso52","tag":"script","children":["5t3tr60oiljGw7POxOLh7h"]},"5t3tr60oiljGw7POxOLh7h":{"page-node-id":"5t3tr60oiljGw7POxOLh7h","type":"text","parentId":"YRDFsu66dU0x8BZaCeU9kY","children":null,"content":"\n      const api = window.dshDesktop\n      const spinner = document.getElementById('spinner')\n      const message = document.getElementById('message')\n      const errorBox = document.getElementById('errorBox')\n      const errorDetail = document.getElementById('errorDetail')\n      const progressWrap = document.getElementById('progressWrap')\n      const progressBar = document.getElementById('progressBar')\n      const progressLabel = document.getElementById('progressLabel')\n      const progressOutput = document.getElementById('progressOutput')\n\n      const OUTPUT_MAX = 200\n\n      function appendOutput(text) {\n        if (!text) return\n        progressOutput.textContent = (progressOutput.textContent + text + '\\n')\n          .split('\\n')\n          .slice(-OUTPUT_MAX)\n          .join('\\n')\n        progressOutput.scrollTop = progressOutput.scrollHeight\n      }\n\n      function showProgress(visible) {\n        progressWrap.classList.toggle('visible', !!visible)\n        if (!visible) progressOutput.textContent = ''\n      }\n\n      function setProgress(p = {}) {\n        const percent = Number(p.percent) || 0\n        progressBar.style.width = `${Math.max(0, Math.min(100, percent))}%`\n        if (p.label) progressLabel.textContent = p.label + (p.message ? ` — ${p.message}` : '')\n        if (p.output) appendOutput(p.output)\n      }\n\n      function showError(text) {\n        spinner.style.display = 'none'\n        errorBox.classList.add('visible')\n        errorDetail.textContent = text\n        message.textContent = '无法启动 dsh 运行时'\n      }\n\n      /**\n       * Install a kernel and boot it.\n       *\n       * The installer only promotes a new snapshot after it has booted and\n       * answered HTTP, so a failure here leaves whatever was there before\n       * exactly as it was — which is why retrying is always safe.\n       */\n      async function installKernel(version) {\n        showError('')\n        errorBox.classList.remove('visible')\n        spinner.style.display = 'block'\n        showProgress(true)\n        setProgress({ percent: 0, label: '正在准备…' })\n        message.textContent = '正在下载内核（约 500 个依赖，需要几分钟）…'\n\n        try {\n          await api.kernel.update(version || 'latest', true)\n          setProgress({ percent: 100, label: '内核就绪，正在启动…' })\n          message.textContent = '内核已就绪，正在载入界面…'\n        } catch (err) {\n          showProgress(false)\n          spinner.style.display = 'none'\n          showError(\n            `内核安装失败：${err && err.message ? err.message : String(err)}\\n\\n` +\n              '当前内核未发生变化，可以稍后重试或换一个镜像源。'\n          )\n        }\n      }\n\n      if (api && typeof api.onStatus === 'function') {\n        api.onStatus((status) => {\n          if (!status) return\n          if (status.state === 'starting') {\n            spinner.style.display = 'block'\n            message.textContent = status.detail || '正在启动…'\n          } else if (status.state === 'ready') {\n            showProgress(false)\n            message.textContent = '已就绪，正在载入界面…'\n          } else if (status.state === 'kernel-missing') {\n            // Nothing to boot. Offer the install instead of a dead retry loop.\n            showError(\n              `${status.detail || '尚未安装 Harness 内核'}\\n\\n` +\n                '首次使用需要下载内核（约 500 个依赖包，数分钟）。'\n            )\n            document.querySelector('#errorBox .error-title').textContent = '需要安装内核'\n          } else if (status.state === 'error') {\n            showError(status.detail || '未知错误')\n          }\n        })\n      } else {\n        message.textContent = '等待主进程…'\n      }\n\n      if (api && typeof api.kernel?.onProgress === 'function') {\n        api.kernel.onProgress(setProgress)\n      }\n\n      document.getElementById('retryBtn').addEventListener('click', async () => {\n        errorBox.classList.remove('visible')\n        spinner.style.display = 'block'\n        message.textContent = '正在重新启动…'\n        try {\n          await api.restart()\n        } catch (err) {\n          showError(err && err.message ? err.message : String(err))\n        }\n      })\n\n      document.getElementById('installBtn').addEventListener('click', () => installKernel('latest'))\n      document.getElementById('kernelBtn').addEventListener('click', () => api.openKernel())\n\n      document.getElementById('logBtn').addEventListener('click', async () => {\n        const s = await api.getStatus()\n        if (s && s.logFile) api.openPath(s.logFile)\n      })\n\n      document.getElementById('dataBtn').addEventListener('click', async () => {\n        const s = await api.getStatus()\n        if (s && s.userData) api.openPath(s.userData)\n      })\n    "},"UI0MhL8Xxw19C39dK8A6qg":{"page-node-id":"UI0MhL8Xxw19C39dK8A6qg","type":"text","parentId":"k3CNzCvd4wbyszIZXKso52","children":null,"content":"\n  "},"Utm4WHlqormrbu8HmLWB9R":{"page-node-id":"Utm4WHlqormrbu8HmLWB9R","type":"text","parentId":"YxLDaOY6Us7cW9xIXyl1BD","children":null,"content":"\n"},"JJL5gYqwcpG3X5YNq6JH2N":{"page-node-id":"JJL5gYqwcpG3X5YNq6JH2N","type":"text","parentId":"root","children":null,"content":"\n"}}