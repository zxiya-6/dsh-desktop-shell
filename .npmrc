##
# dsh-desktop 根 .npmrc
#
# 交接时这个文件意外没进 zip（点文件在打包上传时被过滤），此处按
# src/main/plugins/backup-roll/kernel-package-manager.js 的 npmrcFor() 原样补齐，
# 两者必须保持一致：任何一边改了，另一边要跟着改。
#
# 三件事在这里发生：
#   1. node-linker=hoisted —— dsh 有约 522 个传递依赖，默认的 .pnpm 虚拟存储
#      会给每个包多垫一层路径，在 Windows MAX_PATH(260) 下极易踩雷。
#   2. dangerously-allow-all-builds=true —— pnpm 10 起默认不跑依赖的构建脚本，
#      缺了它 node-pty / koffi / dsh-subprocess-local 会「装完成功、运行时才炸」。
#   3. 二进制镜像 —— 那些构建脚本默认去 GitHub 拉预编译产物，国内拿不到，
#      失败后回退 node-gyp，而大多数用户机器上没有 C++ 工具链。
##

registry=https://registry.npmmirror.com

# pnpm 只在 pnpm 段生效，npm 会忽略
node-linker=hoisted
dangerously-allow-all-builds=true

# 原生模块预编译产物镜像
node_pty_binary_host_mirror=https://registry.npmmirror.com/-/binary/node-pty
sharp_binary_host_mirror=https://registry.npmmirror.com/-/binary/sharp
sharp_libvips_binary_host_mirror=https://registry.npmmirror.com/-/binary/sharp-libvips

# Electron / electron-builder 二进制镜像（打包 dist:win 时需要）
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/

# 可选：若需切换腾讯云镜像，把上面 registry 换成下面这行即可
# registry=https://mirrors.cloud.tencent.com/npm/
