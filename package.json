{
  "name": "dsh-desktop",
  "version": "0.1.2",
  "description": "Desktop shell for DeepSeek Harness (DSH) — bundled runtime, isolated from the system, with a built-in terminal",
  "main": "src/main/index.js",
  "author": "DSH Desktop",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/postinstall.js",
    "assets": "node scripts/copy-assets.js",
    "prebuild": "node scripts/copy-assets.js",
    "smoke:terminal": "electron scripts/smoke-terminal.js",
    "seed:core": "electron scripts/seed-core.js",
    "smoke:kernel": "electron scripts/smoke-kernel.js",
    "smoke:switch": "electron scripts/smoke-switch.js",
    "smoke:phase2": "electron scripts/smoke-phase2.js",
    "smoke:install": "electron scripts/smoke-install.js",
    "smoke:ui": "electron scripts/smoke-ui.js",
    "smoke:migrate": "node scripts/smoke-migrate.js",
    "smoke:paths": "node scripts/smoke-paths.js",
    "smoke:lock": "node scripts/smoke-lock.js",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "dist:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "pnpm": "^10.28.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dshdesktop.app",
    "productName": "DSH Desktop",
    "copyright": "Copyright © 2026 DSH Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.pdb",
      "!**/*.map",
      "!**/node_modules/*/{test,__tests__,tests,examples,doc,docs}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/pnpm/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "uninstallDisplayName": "DSH Desktop ${version}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "DSH-Desktop-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "DSH Desktop",
      "artifactName": "DSH-Desktop-${version}-linux-${arch}.${ext}"
    }
  }
}
